{
  "name": "pokopia-housing-solver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:data",
    "build": "npm run build:data && run-p type-check \"build-only {@}\" --",
    "build:data": "node scripts/build_data.mjs",
    "preview": "vite preview",
    "test:unit": "vitest",
    "pretest:unit": "npm run build:data",
    "test:e2e": "playwright test",
    "harvest:pokemon": "node scripts/harvest_pokemon.js",
    "harvest:items": "node scripts/harvest_items.js",
    "harvest:habitats": "node scripts/harvest_habitats.js",
    "test:harvest": "npm run build:data && node --test \"scripts/*.test.js\"",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/ scripts/",
    "prepare": "husky",
    "check": "run-s format lint build:data type-check test:unit test:harvest"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "^0.45.5",
    "pinia": "^3.0.4",
    "posthog-js": "^1.384.3",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-vue": "~10.9.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "npm-run-all2": "^9.0.1",
    "oxfmt": "^0.54.0",
    "oxlint": "~1.69.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^22.12.0"
  }
}